# Copy to .env.local and fill in from Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the browser. Used for
# admin-only auth management (e.g. supabase.auth.admin.*). Optional until
# those actions are added.
SUPABASE_SERVICE_ROLE_KEY=

# Set to true only in local/dev to show the one-click demo role buttons on
# the login page. Must stay unset (or false) in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
